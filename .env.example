# Supabase — create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dashboard password — generate a bcrypt hash:
#   node -e "require('bcryptjs').hash('your-password', 12).then(h => console.log(h))"
DASHBOARD_PASSWORD_HASH=$2a$12$...your-bcrypt-hash...

# JWT secret — any random 32+ character string
JWT_SECRET=generate-a-random-string-here-at-least-32-chars

# Resend — for invoice reminder emails (https://resend.com)
RESEND_API_KEY=re_...your-api-key
REMINDER_FROM_EMAIL=hello@rebrief.ca

# Cron secret — protects the reminder endpoint
CRON_SECRET=generate-another-random-string

# Anthropic — for PDF invoice extraction (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...your-key-here
